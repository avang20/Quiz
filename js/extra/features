const PIECES={K:"♔",Q:"♕",R:"♖",B:"♗",N:"♘",P:"♙",k:"♚",q:"♛",r:"♜",b:"♝",n:"♞",p:"♟"};
function startChess(){chessBoard=["rnbqkbnr","pppppppp","........","........","........","........","PPPPPPPP","RNBQKBNR"].map(r=>r.split(""));selectedSquare=null;drawChess();status("نوبت سفید است؛ ابتدا مهره و سپس خانه مقصد را انتخاب کن.");}
function drawChess(){const el=$("#qd-chess");if(!el||!chessBoard)return;el.innerHTML='<div class="qd-board">'+chessBoard.flatMap((row,r)=>row.map((p,c)=>`<button class="qd-square ${(r+c)%2?"qd-dark":"qd-light"} ${selectedSquare===r*8+c?"qd-selected":""}" data-chess="${r*8+c}">${PIECES[p]||""}</button>`)).join("")+'</div><p class="qd-muted">شطرنج محلی؛ سفید در برابر بات ساده. ارتقای کامل قوانین ویژه (قلعه‌رفتن و آن‌پاسان) و بازی آنلاین در نسخه بعدی موتور بازی انجام می‌شود.</p>';}
function chessClick(pos){if(!chessBoard)return;const r=Math.floor(pos/8),c=pos%8,p=chessBoard[r][c];if(selectedSquare===null){if(p==="."||p===p.toLowerCase())return;selectedSquare=pos;drawChess();return;}const sr=Math.floor(selectedSquare/8),sc=selectedSquare%8,src=chessBoard[sr][sc];if(!basicLegal(src,sr,sc,r,c)){selectedSquare=null;drawChess();status("حرکت با الگوی این مهره سازگار نیست.");return;}chessBoard[r][c]=src;chessBoard[sr][sc]=".";if(src==="P"&&r===0)chessBoard[r][c]="Q";selectedSquare=null;const moves=[];for(let y=0;y<8;y++)for(let x=0;x<8;x++)if(chessBoard[y][x]!==".")moves.push([y,x]);const candidates=moves.filter(([y,x])=>chessBoard[y][x]===chessBoard[y][x].toLowerCase());if(candidates.length){const [y,x]=candidates[Math.floor(Math.random()*candidates.length)];const targets=[];for(let yy=0;yy<8;yy++)for(let xx=0;xx<8;xx++)if(basicLegal(chessBoard[y][x],y,x,yy,xx))targets.push([yy,xx]);if(targets.length){const [ty,tx]=targets[Math.floor(Math.random()*targets.length)];chessBoard[ty][tx]=chessBoard[y][x];chessBoard[y][x]=".";}}drawChess();status("حرکت ثبت شد.");}
function basicLegal(p,sr,sc,r,c){if(r<0||r>7||c<0||c>7||(sr===r&&sc===c))return false;const t=chessBoard[r][c];if(t!=="."&&(p===p.toUpperCase())===(t===t.toUpperCase()))return false;const dr=r-sr,dc=c-sc,ad=Math.abs(dc),ar=Math.abs(dr),clear=(dy,dx)=>{let y=sr+dy,x=sc+dx;while(y!==r||x!==c){if(chessBoard[y][x]!==".")return false;y+=dy;x+=dx;}return true;};switch(p.toLowerCase()){case"p":return p===p.toUpperCase()?(dc===0&&dr===-1&&t==="."||(ar===1&&dr===-1&&ad===1&&t!==".")):(dc===0&&dr===1&&t==="."||(ar===1&&dr===1&&ad===1&&t!=="."));case"n":return(ar===2&&ad===1)||(ar===1&&ad===2);case"k":return ar<=1&&ad<=1;case"r":return(dr===0||dc===0)&&clear(Math.sign(dr),Math.sign(dc));case"b":return ar===ad&&clear(Math.sign(dr),Math.sign(dc));case"q":return(dr===0||dc===0||ar===ad)&&clear(Math.sign(dr),Math.sign(dc));}return false;}
let uno={hand:[],top:null,deck:[],turn:0};
function startUno(){const colors=["قرمز","آبی","سبز","زرد"],deck=[];colors.forEach(color=>{for(let n=0;n<=9;n++){deck.push({color,value:String(n)});if(n)deck.push({color,value:String(n)});}["توقف","معکوس","+۲"].forEach(value=>deck.push({color,value}));});for(let i=0;i<4;i++)deck.push({color:"وحشی",value:"تغییر رنگ"},{color:"وحشی",value:"+۴"});for(let i=deck.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]];}uno={deck,hand:deck.splice(0,7),bot:deck.splice(0,7),top:deck.pop(),turn:0};drawUno();}
function drawUno(){const el=$("#qd-uno");if(!el)return;el.innerHTML=`<p>کارت روی زمین: <b>${uno.top.color} ${uno.top.value}</b></p><p>کارت‌های بات: ${uno.bot.length} · کارت‌های تو: ${uno.hand.length}</p><div class="qd-row">${uno.hand.map((c,i)=>`<button class="secondary" data-uno="${i}">${c.color} ${c.value}</button>`).join("")}</div>`;}
function unoPlay(i){const card=uno.hand[i];if(!card)return;if(card.color!==uno.top.color&&card.value!==uno.top.value&&card.color!=="وحشی"){status("این کارت قابل بازی نیست.");return;}uno.top=uno.hand.splice(i,1)[0];if(!uno.hand.length){xpAdd(30);status("بردی! ۳۰ XP گرفتی.");}else{const ix=uno.bot.findIndex(c=>c.color===uno.top.color||c.value===uno.top.value||c.color==="وحشی");if(ix>=0)uno.top=uno.bot.splice(ix,1)[0];else uno.bot.push(uno.deck.pop());if(!uno.bot.length){xpAdd(10);status("بات تمام کرد؛ این دور را باختی.");}}drawUno();}
document.addEventListener("DOMContentLoaded",mount);
