 if(b.dataset.task){const task=TASKS.find(t=>t.id===b.dataset.task);if(!task)return;const claimed=JSON.parse(localStorage.getItem("qd_claimed_"+today())||"[]");if(claimed.includes(task.id)){status("این پاداش قبلاً دریافت شده است.");return;}claimed.push(task.id);localStorage.setItem("qd_claimed_"+today(),JSON.stringify(claimed));action({type:"claimTask",taskId:task.id});if(task.type==="xp")xpAdd(task.reward);else{const s=localState();if(task.type==="heart")s.hearts=Math.min(5,(Number(s.hearts)||0)+1);if(task.type==="infinite")s.infiniteHeartsUntil=Math.max(Number(s.infiniteHeartsUntil)||0,Date.now())+task.reward*60*1000;saveLocalState(s);}b.disabled=true;b.textContent="دریافت شد";return;}
 if(b.dataset.accept){action({type:"friendAccept",requestId:b.dataset.accept});return;}
 if(b.dataset.groupJoin){action({type:"groupJoin",groupId:b.dataset.groupJoin});return;}
 const a=b.dataset.action;
 if(a==="friend-request"){const to=$("#qd-friend").value.trim();if(to)action({type:"friendRequest",to});}
